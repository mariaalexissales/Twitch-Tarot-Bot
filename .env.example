# Twitch Credentials
# Log in as your bot channel and go to https://twitchtokengenerator.com
# The access token expires after about 60 days. The bot exits with a login error
# when it does; generate a new one and replace TWITCH_OAUTH_TOKEN.
TWITCH_CHANNEL=YOUR_USERNAME
TWITCH_BOT_USERNAME=BOT_USERNAME
TWITCH_OAUTH_TOKEN=oauth:BOT_ACCESS_TOKEN
